      "regex": "(^|[^A-Za-z0-9])[A-Za-z]:\\\\[A-Za-z0-9_.~-]{2,}"
    },
    {
      "name": "posix-home-path",
      "regex": "(^|[\\s\"'`(=:~])/(home|Users)/[a-z][a-z0-9_-]*/"
    }
  ],
